# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# source PDFs uploaded for reference, not part of the app
/uploads

# Large extracted TCM-SD JSON (recreate with unzip or scripts/download_tcm_sd.sh)
/data/raw/TCM-SD/train.json
/data/raw/TCM-SD/dev.json

# Large fitted matrices (regenerate with python scripts/run_preprocess.py)
/data/processed/*.npz
/data/processed/*_rows.parquet
/data/processed/y_*.joblib

# Large fitted model binaries (retrain with the scripts under scripts/)
/artifacts/models/random_forest/*.joblib
/artifacts/models/logistic_regression/*.joblib
/artifacts/models/svm/*.joblib

# Keep preprocessor joblib in artifacts; ignore Python caches
__pycache__/
*.py[cod]
.ipynb_checkpoints/
